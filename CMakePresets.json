{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64) - generates Reframe.sln",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja - RelWithDebInfo (fast iteration)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ninja-debug",
      "inherits": "ninja-release",
      "displayName": "Ninja - Debug",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "RelWithDebInfo" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" }
  ],
  "testPresets": [
    {
      "name": "vs2022",
      "configurePreset": "vs2022",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
